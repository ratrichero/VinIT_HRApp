# Docker Compose example. Copy to .env; never commit the filled file.
# Compose does NOT start Supabase, PostgreSQL or an LLM server.
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/v1

# Host-published ports stay private; Nginx exposes HTTPS on a VPS.
HRA_BACKEND_BIND=127.0.0.1
HRA_FRONTEND_BIND=127.0.0.1
# Required only with docker-compose.vps.yml: absolute host path to a verified
# database CA certificate, mounted read-only in the backend container.
HRA_DB_CA_PATH=/etc/vinit-hrapp/supabase-db-ca.crt

# Use a reachable Supabase PostgreSQL endpoint. Inside Docker, localhost means
# the backend container, not your host. Add sslmode=require for cloud.
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# Supabase Auth and backend-only Storage credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
# Only needed while legacy HS256 access tokens must still be accepted.
# Asymmetric tokens (ES256/RS256) are verified through Supabase JWKS.
SUPABASE_JWT_SECRET=

# Disabled by default; set a unique high-entropy setup token only while
# bootstrapping the first admin, then remove it from every backend instance.
ADMIN_BOOTSTRAP_TOKEN=

# local is only suitable for development; Compose persists it in a volume.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# An OpenAI-compatible local endpoint, reachable from the backend process.
# localhost inside Docker is not the host; configure a private network address.
LLM_PROVIDER=local
LLM_PROVIDER_NAME=
LLM_MODEL_NAME=llama3.1:8b
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
# Optional: set only if the provider supports seed (determinism is best-effort).
LLM_SEED=
# Required only when an Admin saves an API key for an OpenAI Compatible
# provider in Admin > AI. Generate a Fernet key and keep it only in the
# backend environment; never commit or paste the generated value into Git.
# AI_CONFIG_ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AI_CONFIG_ENCRYPTION_KEY=
# JSON arrays. The default model/endpoint above are automatically included.
# All API/worker instances must use consistent allowlists and secrets.
LLM_ALLOWED_MODELS=[]
LLM_ALLOWED_API_BASES=[]
ALLOW_EXTERNAL_API=false

MANDATORY_CRITERIA_WEIGHT_DEFAULT=0.7
NICE_TO_HAVE_WEIGHT_DEFAULT=0.3
MIN_EVIDENCE_COVERAGE=0.7
# Semantic retrieval/LTR are disabled by default. See doc/MATCHING_STABILITY.md
# before enabling; the hash embedding provider is only for local plumbing tests.
SEMANTIC_RETRIEVAL_ENABLED=false
# Legacy compatibility setting; not an activation gate after migration 00019.
ALLOW_MANAGED_BGE_ROUTING=false
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_INDEX_VERSION=bge-index-v1
SEMANTIC_TOP_K=5
SEMANTIC_MIN_SIMILARITY=0.35
# Legacy settings are not worker activation controls after migration 00019.
ALLOW_MANAGED_LTR_ROUTING=false
LTR_MODE=OFF
LTR_MODEL_PATH=
LTR_MODEL_VERSION=
LTR_MIN_NDCG_AT_10=0.70
LTR_MIN_PAIRWISE_ACCURACY=0.65
LTR_MIN_HOLDOUT_EXAMPLES=20
LTR_MIN_HOLDOUT_GROUPS=2
STRONG_MATCH_SCORE=100
MATCH_SCORE=80
NO_MATCH_SCORE=0
RETENTION_MONTHS=12
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Langfuse AI observability is optional, disabled by default and
# metadata-first. Keep CAPTURE_CONTENT=false; content capture is blocked in
# production by the backend and must only be considered for approved
# synthetic-data environments. Secrets belong only in the backend env.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false
