# Copy to backend/.env and fill in real values. Never commit credentials.
APP_ENV=development
APP_NAME="VinUni HRA API"
DEBUG=false
API_V1_PREFIX=/v1

# Supabase PostgreSQL direct connection; use TLS for cloud deployments.
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# Supabase Auth. Asymmetric tokens (for example ES256) are verified via JWKS
# derived from SUPABASE_URL; the secret below is only for legacy HS256 tokens
# and may be left empty after those tokens are no longer accepted.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=
# Optional overrides; normally derived from SUPABASE_URL.
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=300

# Leave empty except during the one-time first-admin setup. Generate a unique,
# high-entropy token (at least 32 characters) and remove it after setup.
ADMIN_BOOTSTRAP_TOKEN=

# Supabase buckets must be private and accessed via the backend service role.
STORAGE_BACKEND=supabase
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# Environment defaults and operator allowlists. The allowlists still bound
# local/openai/azure choices; an Admin-managed OpenAI Compatible provider can
# define its own provider name, Base URL and model in the Admin UI.
# localhost is valid only when the model is in the same network namespace.
LLM_PROVIDER=local
LLM_PROVIDER_NAME=
LLM_MODEL_NAME=llama3.1:8b
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
# Optional: set only if the provider supports seed (determinism is best-effort).
LLM_SEED=
# Required only when an Admin saves an API key for an OpenAI Compatible
# provider. Generate a Fernet key and keep it only in this backend env file;
# never commit or paste the generated value into Git. Rotating it makes
# previously saved provider keys undecryptable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=
# JSON arrays. The default model/endpoint above are automatically included.
# All API/worker instances must use consistent allowlists and secrets.
LLM_ALLOWED_MODELS=[]
LLM_ALLOWED_API_BASES=[]
ALLOW_EXTERNAL_API=false

MIN_EVIDENCE_COVERAGE=0.7

# Semantic retrieval is disabled by default. To enable BGE, serve a model
# through an OpenAI-compatible /embeddings endpoint and set provider=bge_http.
# The hash provider is only for local plumbing tests, not semantic quality.
SEMANTIC_RETRIEVAL_ENABLED=false
# Managed BGE routes require this gate and SEMANTIC_RETRIEVAL_ENABLED.
ALLOW_MANAGED_BGE_ROUTING=false
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_INDEX_VERSION=bge-index-v1
SEMANTIC_TOP_K=5
SEMANTIC_MIN_SIMILARITY=0.35

# Learning-to-Rank is disabled by default. SHADOW records scores without
# changing rank order; ACTIVE requires a gated artifact and only reorders
# inside the existing mandatory-status/coverage gates.
# Managed LTR is SHADOW-only; selecting OFF here does not disable legacy LTR.
ALLOW_MANAGED_LTR_ROUTING=false
LTR_MODE=OFF
LTR_MODEL_PATH=
LTR_MODEL_VERSION=
LTR_MIN_NDCG_AT_10=0.70
LTR_MIN_PAIRWISE_ACCURACY=0.65
LTR_MIN_HOLDOUT_EXAMPLES=20
LTR_MIN_HOLDOUT_GROUPS=2

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Langfuse AI observability is optional, disabled by default and
# metadata-first. Keep CAPTURE_CONTENT=false; content capture is blocked in
# production by the backend and must only be considered for approved
# synthetic-data environments. Secrets belong only in the backend env.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false
